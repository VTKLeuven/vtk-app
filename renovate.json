{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":preserveSemverRanges",
    ":semanticCommits",
    ":semanticCommitScopeDisabled",
    "mergeConfidence:all-badges"
  ],
  "timezone": "Europe/Brussels",
  "labels": ["dependencies"],
  "prConcurrentLimit": 4,
  "minimumReleaseAge": "3 days",
  "platformAutomerge": false,
  "osvVulnerabilityAlerts": true,
  "packageRules": [
    {
      "description": "Na elke wijziging aan de app hoort een EAS Update (zie AGENTS.md), dus een dependency mergt nooit automatisch.",
      "matchManagers": ["npm"],
      "automerge": false
    },
    {
      "description": "Expo ships its SDK as one set: expo, the expo-* modules, React, React Native and the babel/eslint presets belong in a single PR.",
      "matchPackageNames": [
        "expo",
        "expo-*",
        "@expo/*",
        "@expo-google-fonts/*",
        "react",
        "react-dom",
        "@types/react",
        "react-native",
        "react-native-*",
        "babel-preset-expo",
        "eslint-config-expo"
      ],
      "groupName": "expo sdk"
    },
    {
      "description": "Action digest pins in one weekly PR. A major bump of an action stays manual: it can change inputs.",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["patch", "minor", "digest", "pin"],
      "groupName": "github actions",
      "automerge": true
    }
  ]
}
