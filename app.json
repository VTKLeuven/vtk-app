{
  "expo": {
    "name": "VTK",
    "slug": "vtk-app",
    "owner": "vtk-it",
    "scheme": "vtk",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "be.vtk.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png",
        "backgroundColor": "#0E1A36"
      },
      "package": "be.vtk.app",
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0E1A36"
        }
      ],
      "expo-router",
      "expo-font",
      "expo-sqlite",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "color": "#FFD23F"
        }
      ],
      [
        "expo-media-library",
        {
          "savePhotosPermission": "VTK bewaart een foto uit een album in je fotobibliotheek.",
          "photosPermission": "VTK bewaart een foto uit een album in je fotobibliotheek.",
          "isAccessMediaLocationEnabled": false,
          "granularPermissions": []
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "VTK gebruikt je camera enkel om een QR-code te scannen: een ticket aan de deur, een uitnodiging om te mogen scannen, de code aan de fakbar of de pas van een student.",
          "recordAudioAndroid": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "VTK zet een evenement in je agenda wanneer je daarop tikt. Er wordt niets gelezen of gewijzigd zonder dat je het vraagt.",
          "remindersPermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": false,
          "locationWhenInUsePermission": "VTK gebruikt je locatie enkel om de wandelroute naar een lokaal vanaf je eigen positie te tekenen. Er wordt niets bewaard of doorgestuurd.",
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false,
          "locationAlwaysPermission": false,
          "motionUsagePermission": false,
          "locationFullAccuracyPermission": false
        }
      ],
      "expo-image",
      "expo-sharing",
      "expo-status-bar"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2858ac35-d566-4e4d-8351-3c36bed26693"
      }
    },
    "runtimeVersion": "exposdk:58.0.0",
    "platforms": [
      "ios",
      "android"
    ],
    "updates": {
      "url": "https://u.expo.dev/2858ac35-d566-4e4d-8351-3c36bed26693"
    }
  }
}
